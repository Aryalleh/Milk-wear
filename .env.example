# کپی کنید به .env و مقادیر را تنظیم کنید
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=milk
DB_PASSWORD=milk_dev_pass
DB_NAME=milk_wear
SESSION_SECRET=change-me-in-production
# فقط وقتی اپ صرفاً پشت HTTPS (تانل) سرو می‌شود true کنید
COOKIE_SECURE=false
# توکن بازوی بله برای اعتبارسنجی لاگین خودکار مینی‌اپ (از @botfather)
BALE_BOT_TOKEN=
# نام کاربری بازو (بدون @) برای ساخت دیپ‌لینک فاکتور در پیام بله
BALE_BOT_USERNAME=
# آدرس عمومی اپ (برای لینک رنگیِ فاکتور در پیام بله)، مثل https://milk.example.com
APP_PUBLIC_URL=
