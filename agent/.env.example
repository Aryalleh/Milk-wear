# --- اتصال به سرور ---
# روی همین سیستم برای تست: http://localhost:3000
# سرور ابری/دامنه: https://milk.example.com
SERVER_URL=http://localhost:3000

# توکن را از «تنظیمات ← چاپ و سفارش‌گیری ← پرینت‌ایجنت» کپی کنید (بدون فاصله/کامنت)
AGENT_TOKEN=

AGENT_ID=shop-agent
POLL_SECONDS=3

# --- پرینتر ---
# مقادیر مجاز: file | network | usb | serial
# file = حالت تست؛ به‌جای چاپ، هر سند را در out/*.png ذخیره می‌کند
PRINTER_TYPE=file

# عرض چاپ به نقطه: 80mm@203dpi = 576 (بعضی مدل‌ها 512)
PRINTER_WIDTH=576

# پرینتر شبکه (اترنت/Wi-Fi):
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100

# پرینتر USB (شناسه‌ها را با lsusb یا Zadig پیدا کنید):
PRINTER_USB_VENDOR=0x0416
PRINTER_USB_PRODUCT=0x5011
# اندپوینت/اینترفیس — فقط اگر پیش‌فرض کار نکرد؛ از «lsusb -v -d VID:PID» بردارید:
PRINTER_USB_INTERFACE=0
PRINTER_USB_IN_EP=0x82
PRINTER_USB_OUT_EP=0x02

# پرینتر سریال:
PRINTER_SERIAL_DEV=/dev/ttyUSB0
PRINTER_BAUD=9600

# فونت و ظاهر سند توسط سرور رندر می‌شود؛ ایجنت فقط تصویر آماده را چاپ می‌کند.

# --- پنل وب مدیریت ---
# پنل روی این آدرس/پورت بالا می‌آید. 0.0.0.0 = از هر سیستمی در شبکهٔ محلی قابل دسترس.
# برای محدودکردن به همین دستگاه: PANEL_HOST=127.0.0.1
PANEL_HOST=0.0.0.0
PANEL_PORT=7000

# نکته: پس از اولین اجرا، همهٔ این مقادیر در config.json ذخیره می‌شوند و بهتر است
# از این‌به‌بعد تنظیمات را از «پنل وب» (http://localhost:7000) انجام دهید، نه این فایل.
