# --- اتصال به سرور ---
# روی همین سیستم برای تست: http://localhost:3000
# سرور ابری/دامنه: https://milk.example.com
SERVER_URL=http://localhost:3000

# توکن را از «تنظیمات ← چاپ و سفارش‌گیری ← پرینت‌ایجنت» کپی کنید (بدون فاصله/کامنت)
AGENT_TOKEN=

AGENT_ID=shop-agent
POLL_SECONDS=3

# --- پرینتر ---
# مقادیر مجاز: file | network | usb | serial
# file = حالت تست؛ به‌جای چاپ، هر سند را در out/*.png ذخیره می‌کند
PRINTER_TYPE=file

# عرض چاپ به نقطه: 80mm@203dpi = 576 (بعضی مدل‌ها 512)
PRINTER_WIDTH=576

# پرینتر شبکه (اترنت/Wi-Fi):
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100

# پرینتر USB (شناسه‌ها را با lsusb یا Zadig پیدا کنید):
PRINTER_USB_VENDOR=0x0416
PRINTER_USB_PRODUCT=0x5011

# پرینتر سریال:
PRINTER_SERIAL_DEV=/dev/ttyUSB0
PRINTER_BAUD=9600

# فونت و ظاهر سند توسط سرور رندر می‌شود؛ ایجنت فقط تصویر آماده را چاپ می‌کند.
