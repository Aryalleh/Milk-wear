# --- اتصال به سرور ---
SERVER_URL=https://milk.mfadem.ir
AGENT_TOKEN=            # از «تنظیمات ← چاپ و سفارش‌گیری ← پرینت‌ایجنت» کپی کنید
AGENT_ID=shop-agent    # نامی دلخواه برای این ایجنت
POLL_SECONDS=3

# --- پرینتر ---
# network | usb | serial | file(تست، PNG می‌سازد) | dummy
PRINTER_TYPE=file
PRINTER_WIDTH=576      # 80mm@203dpi = 576 نقطه (بعضی مدل‌ها 512)

# شبکه (پرینتر با پورت اترنت / Wi-Fi):
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100

# USB (شناسه‌ها را با `lsusb` روی لینوکس یا Zadig روی ویندوز پیدا کنید):
PRINTER_USB_VENDOR=0x0416
PRINTER_USB_PRODUCT=0x5011

# سریال:
PRINTER_SERIAL_DEV=/dev/ttyUSB0
PRINTER_BAUD=9600

# --- فونت فارسی (کنار همین پوشه در fonts/ بگذارید) ---
FONT_REGULAR=fonts/Vazirmatn-Regular.ttf
FONT_BOLD=fonts/Vazirmatn-Bold.ttf
